# Frontend Environment Variables — Bhumi Vikas Sahayak
# Copy to .env.local for local overrides. In production (Vercel), configure via Vercel Dashboard.

# Production backend API URL.
# If deploying fullstack in a single Vercel project, leave empty to use relative same-origin calls (/api/...)
# If deploying frontend separately from backend, set to your backend deployment URL, e.g.:
# VITE_API_URL=https://your-backend-api.vercel.app
VITE_API_URL=
VITE_API_BASE_URL=
