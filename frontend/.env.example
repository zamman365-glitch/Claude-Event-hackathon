# Environment variables for Bhumi Vikas Sahayak
# Copy to .env.local and fill in real values — never commit secrets

# Backend API base URL (leave empty to use mock/local data)
VITE_API_BASE_URL=

# MP Bhulekh / land records API key (when available)
VITE_BHULEKH_API_KEY=

# Any government open-data API keys go here
VITE_GOVDATA_API_KEY=
