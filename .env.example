# Bhumi Vikas Sahayak Environment Configuration
# Supported PROVIDER options: gemini, openai, cerebras, mock
PROVIDER=gemini

# Models (read directly from env vars, no hardcoded models)
# Gemini:   gemini-2.0-flash or gemini-1.5-flash
# OpenAI:   gpt-4o-mini or gpt-4o
# Cerebras: llama-3.3-70b or llama3.1-8b
MODEL_FAST=gemini-2.0-flash
MODEL_ANSWER=gemini-2.0-flash

# API Keys (set according to chosen PROVIDER — do NOT commit real keys)
GEMINI_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=

# Optional custom base URL for OpenAI-compatible providers
# OPENAI_BASE_URL=https://api.cerebras.ai/v1

# Frontend Base API URL (Leave blank on Vercel when deployed together; same-origin relative /api is used)
# VITE_API_URL=https://your-domain.vercel.app

